[Unit]
Description=Wonhee VPN-only forwarder to localhost Navidrome
Documentation=https://github.com/yooshastan/Wonhee-Proxy
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
# Restrict access to the WireGuard interface's own IPv4 address, never 0.0.0.0.
ExecStart=/usr/bin/socat TCP-LISTEN:4533,bind=10.77.0.1,reuseaddr,fork TCP:127.0.0.1:4533
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
