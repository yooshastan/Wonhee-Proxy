<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug-only: resolve local UID ownership for explicit all-app preview. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application
        android:name=".RootlabApplication"
        tools:replace="android:name">
        <!-- This separate debug package cannot auto-register a normal VPN,
             schedule root recovery jobs, or reconfigure networking at boot. -->
        <service android:name="com.wireguard.android.backend.GoBackend$VpnService"
            tools:node="remove" />
        <service android:name=".VpnTrafficNotificationService"
            tools:node="remove" />
        <service android:name=".RootMultiTrafficNotificationService"
            tools:node="remove" />
        <service android:name=".VpnRecoveryJobService"
            tools:node="remove" />
        <service android:name=".RootMultiRecoveryJobService"
            tools:node="remove" />
        <service android:name=".WonheeQuickSettingsTile"
            tools:node="remove" />
        <receiver android:name=".RootMultiRecoveryBootReceiver"
            tools:node="remove" />
        <activity android:name=".VpnActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <!-- Disable the ordinary Connect/Start dashboard in this diagnostic
             variant. This is NOT the live multi-exit beta yet. -->
        <activity
            android:name=".WonheeDashboardPreviewActivity"
            android:enabled="false" android:exported="false" tools:node="replace" />
        <!-- Explicitly opted-in, debug-only independent WireGuard link pilot.
             Neither its label nor its controls claim Android app routing. -->
        <activity
            android:name=".RootlabTwoPeerActivity"
            android:exported="false"
            android:label="Wonhee Two Exits + Home Lab">
        </activity>
        <!-- RootLab-only separate launcher icon. The official release
             does not include this activity or any new root capability. -->
        <!-- Debug-only TUN ingress experiment. It captures only this package
             and one synthetic IPv4 benchmark route; never a default route. -->
        <activity
            android:name=".RootlessNativePeerActivity"
            android:exported="false"
            android:label="Wonhee Combined Transfer Test">
        </activity>
        <service android:name=".RootlessNativePeerService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false" android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated debug test: own-package IPv4 host routes, bounded credential-free HTTP and fixed UDP DNS probes, no default route" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <activity android:name=".NativeAppRoutingActivity"
            android:exported="true" android:label="Wonhee Proxy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".NativeAppRoutingService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false" android:foregroundServiceType="specialUse">
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated debug VPN for selected or all apps in current Android user, two independent encrypted exits and optional private Home route" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <activity
            android:name=".RootlabReadinessActivity"
            android:exported="false"
            android:label="Wonhee Multi-Exit Readiness">
        </activity>
    </application>
</manifest>
